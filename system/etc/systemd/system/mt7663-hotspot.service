[Unit]
Description=MediaTek MT7663 SoftAP Hotspot Service (ap0)
After=network.target
Wants=network.target

[Service]
Type=forking
PIDFile=/run/mt7663-hostapd.pid
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStartPre=-/usr/sbin/rfkill unblock all
ExecStartPre=-/sbin/modprobe wlan_mt7663_sdio ap_mode=1
ExecStart=/usr/sbin/mt7663-hotspot start
ExecStop=/usr/sbin/mt7663-hotspot stop
Restart=always
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
