#!/bin/sh
set -e

# Disable system-wide dnsmasq to prevent DHCP port 67 binding conflicts
systemctl stop dnsmasq 2>/dev/null || true
systemctl disable dnsmasq 2>/dev/null || true

# Clean up stale hostapd configurations completely
rm -f /etc/hostapd/hostapd.conf /etc/hostapd/hostapd.conf.bak /etc/hostapd/*.conf.old 2>/dev/null || true

# Set proper permissions
chmod 755 /usr/sbin/mt7663-hotspot 2>/dev/null || true
chmod 755 /etc/NetworkManager/dispatcher.d/90-wlan0-routing.sh 2>/dev/null || true
chmod 755 /usr/lib/mt7663-webui/server.py 2>/dev/null || true
chmod 755 /etc/update-motd.d/15-ap-info 2>/dev/null || true

# Apply sysctl routing & ARP rules
sysctl -p /etc/sysctl.d/99-mt7663.conf 2>/dev/null || true

# Ensure module configuration options are active
if ! ip link show ap0 >/dev/null 2>&1; then
    echo "[INFO] Module options installed in /etc/modprobe.d/wlan_mt7663_sdio.conf"
    echo "[INFO] If ap0 interface does not appear immediately, please reboot (sudo reboot) to cleanly initialize dual AP/STA mode on SDIO hardware."
fi

# Enable and start services
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload 2>/dev/null || true
    systemctl enable mt7663-hotspot.service 2>/dev/null || true
    systemctl restart mt7663-hotspot.service 2>/dev/null || true
    systemctl enable mt7663-webui.service 2>/dev/null || true
    systemctl restart mt7663-webui.service 2>/dev/null || true
fi

echo "mt7663-router-webui installed successfully! Web UI available at http://10.10.10.1:8080"
