#!/bin/sh
set -e

case "$1" in
    remove|purge)
        # Clean up modprobe configuration
        rm -f /etc/modprobe.d/wlan_mt7663_sdio.conf 2>/dev/null || true
        rm -f /etc/sysctl.d/99-mt7663.conf 2>/dev/null || true
        rm -f /etc/update-motd.d/15-ap-info 2>/dev/null || true
        rm -f /etc/NetworkManager/dispatcher.d/90-wlan0-routing.sh 2>/dev/null || true
        rm -rf /usr/lib/mt7663-webui 2>/dev/null || true

        # Re-apply default sysctl
        sysctl -p /etc/sysctl.d/99-wifi-throughput.conf 2>/dev/null || true

        # Clean up governor tuning from Armbian Ophub custom service
        OPHUB_START_SERVICE="/etc/custom_service/start_service.sh"
        if [ -f "$OPHUB_START_SERVICE" ]; then
            sed -i '/# MT7663-GOVERNOR-TUNING-START/,/# MT7663-GOVERNOR-TUNING-END/d' "$OPHUB_START_SERVICE" 2>/dev/null || true
        fi

        # Reload driver back to pure wlan0 client mode
        if ip link show ap0 >/dev/null 2>&1 && lsmod | grep -q wlan_mt7663_sdio; then
            echo "Restoring wlan_mt7663_sdio to pure wlan0 mode..."
            modprobe -r wlan_mt7663_sdio 2>/dev/null || true
            modprobe wlan_mt7663_sdio 2>/dev/null || true
        fi

        if [ -d /run/systemd/system ]; then
            systemctl daemon-reload 2>/dev/null || true
        fi
        echo "mt7663-router-webui removed cleanly. System returned to pure wlan0 state."
        ;;
esac
